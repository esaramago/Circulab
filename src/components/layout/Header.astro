---
import { m } from '@/paraglide/messages.js'
import { localizeHref, deLocalizeHref } from '@/paraglide/runtime.js'
import Grid from '@/components/ui/Grid.vue'
import HeaderActions from '@/components/layout/HeaderActions.vue'
import { userHasAccess } from '@/utils/userHasAccess'
import { createClient } from '@/utils/supabase'

const path = deLocalizeHref(Astro.url.pathname + Astro.url.search)
const currentLocale = Astro.locals.locale
const currentPath = Astro.url.pathname
const user = Astro.locals.user

let pendingSuggestionsCount = 0
if (user && userHasAccess(user, 'moderation')) {
  try {
    const supabase = createClient({ request: Astro.request, cookies: Astro.cookies })
    const { count, error } = await supabase
      .from('suggested_pins')
      .select('*', { count: 'exact', head: true })
      .eq('status', 'standby')

    if (!error && typeof count === 'number') {
      pendingSuggestionsCount = count
    }
  } catch (error) {
    console.error('[Header] Error fetching pending suggestions count:', error)
  }
}

const langs = [
  {
    locale: 'pt',
    href: localizeHref(path, { locale: 'pt' }),
    label: 'PT'
  },
  { locale: 'en',
    href: localizeHref(path, { locale: 'en' }),
    label: 'EN'
  },
]

const navItems = [
  {
    path: '/',
    label: m['nav.home']()
  },
  {
    path: '/mapa',
    label: m['map.title']()
  },
  {
    path: '/sobre',
    label: m['about.title']()
  },
  {
    path: '/contactos',
    label: m['contacts.title']()
  }
]

---

<header>
  <Grid gap="xl" align="center">
    <a href={localizeHref('/')}>
      <img src="/img/circulab-logo.svg" alt={m.site_title()} height="24" />
    </a>
    <nav>
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={localizeHref(item.path)} class:list={item.path === currentPath ? 'is-active' : ''}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </Grid>
  <HeaderActions
    client:load
    user={user}
    pendingSuggestionsCount={pendingSuggestionsCount}
    langLink={langs.find((lang) => lang.locale !== currentLocale)}
  />
</header>

<wa-drawer id="header-drawer" class="nav-drawer" label={m['nav.menu']()}>
  <nav>
    <ul class="nav-list">
      {navItems.map((item) => (
        <li>
          <a href={localizeHref(item.path)} class:list={item.path === currentPath ? 'is-active' : ''}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <Grid gap="s" align="center">
    <ul class="nav-lang">
      {langs.map((lang) => (
        <li>
          <a href={lang.href} class:list={lang.locale === currentLocale ? 'is-active' : ''}>{lang.label}</a>
        </li>
      ))}
    </ul>
  </Grid>
</wa-drawer>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--wa-space-l);
    justify-self: start;
    padding: var(--wa-space-s) var(--wa-space-l);
    background-color: var(--wa-color-brand-20);
    @media (min-width: 768px) {
      flex-wrap: nowrap;
      gap: var(--wa-space-xl);
      padding: var(--wa-space-m) var(--wa-space-xl);
    }
    @media (max-width: 767px) {
      .nav-lang,
      nav {
        display: none;
      }
    }
  }
  .header__subtitle {
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-neutral-80);
  }

  .nav-list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-direction: column;
  }
  .nav-lang,
  .nav-list a {
    position: relative;
    display: block;
    padding: var(--wa-space-xs) var(--wa-space-xs) var(--wa-space-3xs);
    border-block-end: 3px solid transparent;
    text-decoration: none;
    font-weight: var(--wa-font-weight-semibold);
    transition: color 0.2s ease, border-color 0.2s ease;
    &:hover,
    &.is-active {
      color: var(--wa-color-brand-60);
      font-weight: var(--wa-font-weight-bold);
      border-block-end-color: var(--wa-color-brand-60);
    }
  }

  @media (min-width: 768px) {
    .nav-lang,
    .nav-list {
      flex-direction: row;
      gap: var(--wa-space-m);
    }
  }

  .nav-drawer::part(body) {
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-l);
  }
</style>

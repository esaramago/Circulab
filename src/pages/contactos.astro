---
import Layout from '@/layouts/Layout.astro'
import { m } from '@/paraglide/messages.js'
import Container from '@/components/ui/Container.vue'
import Grid from '@/components/ui/Grid.vue'
import Icon from '@/components/ui/Icon.vue'
import Headline from '@/components/ui/Headline.vue'
import ContactForm from '@/components/contacts/ContactForm.vue'
import { localizeHref } from '@/paraglide/runtime.js'
---

<script>
  import '@awesome.me/webawesome/dist/components/button/button.js'
  import '@awesome.me/webawesome/dist/components/card/card.js'
  import '@awesome.me/webawesome/dist/components/icon/icon.js'
  import '@awesome.me/webawesome/dist/components/callout/callout.js'
  import '@awesome.me/webawesome/dist/components/badge/badge.js'
</script>

<Layout title={m['contacts.title']()}>
  <Container width="m">
    <Headline title={m['contacts.title']()} subtitle={m['contacts.subtitle']()}>
      <wa-badge appearance="filled" pill>
        <wa-icon slot="start" name="envelope"></wa-icon>
        {m['contacts.title']()}
      </wa-badge>
    </Headline>

    <div class="contacts-grid">
      <wa-card class="info-card">
        <h2>{m['contacts.info_title']()}</h2>
        <Grid direction="column">
          <div class="info-item">
            <Icon name="envelope" appearance="filled"></Icon>
            <div class="info-content">
              <span class="info-label">{m['contacts.info_email']()}</span>
              <a href="mailto:info@circulab.pt" class="info-value">info@circulab.pt</a>
            </div>
          </div>

          <div class="info-item">
            <Icon name="location-dot" appearance="filled"></Icon>
            <div class="info-content">
              <span class="info-label">{m['contacts.info_location']()}</span>
              <span class="info-value">{m['contacts.info_location_value']()}</span>
            </div>
          </div>

          <div class="info-item">
            <Icon name="clock" appearance="filled"></Icon>
            <div class="info-content">
              <span class="info-label">{m['contacts.info_response']()}</span>
              <span class="info-value">{m['contacts.info_response_value']()}</span>
            </div>
          </div>
        </Grid>

        <wa-callout variant="neutral" class="info-callout">
          <wa-icon slot="icon" name="circle-info"></wa-icon>
          <p>{m['contacts.suggest_callout']()}</p>
          <wa-button href={`${localizeHref('/recursos/novo')}`}>{m['contacts.suggest_button']()}</wa-button>
        </wa-callout>
      </wa-card>

      <wa-card class="form-card">
        <h2>{m['contacts.form_title']()}</h2>
        <ContactForm client:only="vue" />
      </wa-card>
    </div>
  </Container>
</Layout>

<style scoped>
  .contacts-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-block-end: var(--wa-space-l);
  }

  .contacts-badge {
    margin-block-end: var(--wa-space-s);
  }

  h1 {
    font-size: var(--wa-font-size-3xl);
    margin-block-end: var(--wa-space-xs);
  }

  .contacts-subtitle {
    font-size: var(--wa-font-size-l);
    color: var(--wa-color-brand-70);
    max-width: 60rem;
    margin-inline: auto;
  }

  .contacts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--wa-space-xl);
    align-items: start;
    @media (min-width: 768px) {
      grid-template-columns: 1fr 1.3fr;
    }
  }

  .info-card,
  .form-card {
    background-color: var(--wa-color-brand-30);
    border: 1px solid var(--wa-color-brand-40);
    border-radius: var(--wa-border-radius-l);
  }

  h2 {
    font-size: var(--wa-font-size-xl);
    margin-block-end: var(--wa-space-l);
    color: var(--wa-color-neutral-fill-loud);
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: var(--wa-space-m);
  }

  .info-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--wa-border-radius-medium);
    background-color: var(--wa-color-brand-20);
    color: var(--wa-color-brand-70);
    font-size: var(--wa-font-size-l);
    flex-shrink: 0;
  }

  .info-content {
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-3xs);
  }

  .info-label {
    font-size: var(--wa-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--wa-color-brand-70);
    font-weight: var(--wa-font-weight-semibold);
  }

  .info-value {
    font-size: var(--wa-font-size-m);
    color: var(--wa-color-neutral-fill-loud);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a.info-value:hover {
    color: var(--wa-color-brand-90);
    text-decoration: underline;
  }

  .info-callout {
    margin-block-start: var(--wa-space-m);
  }
</style>
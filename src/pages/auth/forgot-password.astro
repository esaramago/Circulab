---
import Layout from '@/layouts/Layout.astro'
import { resetPassword } from '@/actions/auth/resetPassword'
import Grid from '@/components/ui/Grid.vue'
import Container from '@/components/ui/Container.vue'
import { localizeHref } from '@/paraglide/runtime.js'
import { m } from '@/paraglide/messages.js'

let errorMessage = ''
let successMessage = ''

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()

  try {
    const { data, error } = await Astro.callAction(resetPassword, formData)
    if (error) {
      throw new Error(error.message || m['auth.failed_send_reset']())
    }
    if (data?.success) {
      successMessage = data.message ?? m['auth.reset_email_sent']()
    }
  } catch (error: unknown) {
    errorMessage = error instanceof Error ? error.message : m['auth.failed_send_reset']()
  }
}

const loginHref = localizeHref('/login', Astro.locals.locale ? { locale: Astro.locals.locale } : undefined)
---

<script>
  import '@awesome.me/webawesome/dist/components/button/button.js'
  import '@awesome.me/webawesome/dist/components/input/input.js'
</script>

<Layout title={m['auth.reset_password_title']()}>
  <Container width="xs">
    <h1>{m['auth.reset_password_title']()}</h1>
    <p>{m['auth.reset_password_desc']()}</p>
    {errorMessage && <wa-alert variant="danger">{errorMessage}</wa-alert>}
    {successMessage && <wa-alert variant="success">{successMessage}</wa-alert>}
    {!successMessage && (
      <form method="post">
        <Grid gap="s" direction="column">
          <wa-input
            id="email"
            type="email"
            name="email"
            required
            label={m['auth.email_label']()}
            placeholder={m['auth.email_label']()}
            autofocus
          />
          <wa-button variant="primary" type="submit">{m['auth.send_reset_link']()}</wa-button>
        </Grid>
      </form>
    )}
    <p>
      <a href={loginHref}>{m['auth.back_to_login']()}</a>
    </p>
  </Container>
</Layout>

---
import Layout from '@/layouts/Layout.astro'
import { signIn } from '@/actions/auth/signIn'
import Grid from '@/components/ui/Grid.vue'
import Container from '@/components/ui/Container.vue'
import { getSafeRedirectPath, localizeRedirectPath } from '@/utils/authRedirect'
import { localizeHref } from '@/paraglide/runtime.js'
import { m } from '@/paraglide/messages.js'

let errorMessage = ''
let successMessage = ''
if (Astro.url.searchParams.get('error') === 'auth') {
  errorMessage = m['auth.invalid_link']()
}
if (Astro.url.searchParams.get('success') === 'password') {
  successMessage = m['auth.password_updated']()
}
const forgotPasswordHref = localizeHref(
  '/auth/forgot-password',
  Astro.locals.locale ? { locale: Astro.locals.locale } : undefined,
)
const redirectAfterLogin = getSafeRedirectPath(
  Astro.url.searchParams.get('redirect')
)
const ADMIN_EMAIL = process.env.PUBLIC_ADMIN_EMAIL
const ADMIN_PASSWORD = process.env.PUBLIC_ADMIN_PASSWORD

if (Astro.request.method === 'POST') {

  const formData = await Astro.request.formData()

  try {

    const email = formData.get('email')
    const password = formData.get('password')
    const redirectTarget = getSafeRedirectPath(
      (formData.get('redirect') as string) || Astro.url.searchParams.get('redirect')
    )
    if (!email || !password) {
      throw new Error(m['auth.email_password_required']())
    }

    const { data: loginData, error: loginError } = await Astro.callAction(signIn, formData)
    if (loginError) {
      throw new Error(loginError.message || m['auth.failed_sign_in']())
    }

    if (loginData?.success) {

      const hasAccessToDashboard = Astro.locals.user?.role_id === 2 || Astro.locals.user?.role_id === 3
      if (hasAccessToDashboard) {
        return Astro.redirect(localizeRedirectPath(redirectTarget, Astro.locals.locale))
      } else {
        errorMessage = m['auth.no_dashboard_access']()
      }
    } else {
      errorMessage = loginData?.message || m['auth.failed_sign_in']()
    }

  } catch (error: any) {
    console.error('Login error:', error)
    errorMessage = error.message
  }
}
---

<script>
  import '@awesome.me/webawesome/dist/components/button/button.js'
  import '@awesome.me/webawesome/dist/components/input/input.js'
</script>

<Layout title={m['auth.login_title']()}>
  <Container width="xs">
    <h1>{m['auth.login_title']()}</h1>
    {errorMessage && <wa-alert variant="danger">{errorMessage}</wa-alert>}
    {successMessage && <wa-alert variant="success">{successMessage}</wa-alert>}
    <form method="post">
      <input type="hidden" name="redirect" value={redirectAfterLogin} />
      <Grid gap="s" direction="column">
        <wa-input
          id="email"
          type="email"
          name="email"
          required
          label={m['auth.email_label']()}
          placeholder={m['auth.email_label']()}
          value={ADMIN_EMAIL}
          autofocus
        />
        <wa-input
          id="password"
          type="password"
          name="password"
          label={m['auth.password_label']()}
          required
          placeholder={m['auth.password_label']()}
          value={ADMIN_PASSWORD}
        />
        <wa-button variant="primary" type="submit">{m['auth.login_button']()}</wa-button>
        <p>
          <a href={forgotPasswordHref}>{m['auth.forgot_password']()}</a>
        </p>
      </Grid>
    </form>
  </Container>
</Layout>

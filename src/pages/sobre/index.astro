---
import Layout from '@/layouts/Layout.astro'
import { m } from '@/paraglide/messages.js'
import Container from '@/components/ui/Container.vue'
import { localizeHref } from '@/paraglide/runtime.js'
import Grid from '@/components/ui/Grid.vue'
import Headline from '@/components/ui/Headline.vue'
import Icon from '@/components/ui/Icon.vue'
---

<script>
  import '@awesome.me/webawesome/dist/components/card/card.js'
  import '@awesome.me/webawesome/dist/components/icon/icon.js'
  import '@awesome.me/webawesome/dist/components/button/button.js'
  import '@awesome.me/webawesome/dist/components/callout/callout.js'
  import '@awesome.me/webawesome/dist/components/accordion/accordion.js'
  import '@awesome.me/webawesome/dist/components/accordion-item/accordion-item.js'
  import '@awesome.me/webawesome/dist/components/badge/badge.js'
</script>

<Layout title={m['about.title']()}>
  <Container width="m">
    <Headline title={m['about.title']()} subtitle={m['about.subtitle']()}>
      <wa-badge variant="brand" appearance="filled" pill>
        <wa-icon slot="start" name="circle-info"></wa-icon>
        {m['about.title']()}
      </wa-badge>
    </Headline>

    <Grid direction="row" fullWidth break="small">
      <wa-card>
        <Icon name="bullseye" appearance="filled"></Icon>
        <h2>{m['about.mission_title']()}</h2>
        <p>{m['about.mission_desc']()}</p>
      </wa-card>

      <wa-card>
        <Icon name="eye" appearance="filled"></Icon>
        <h2>{m['about.vision_title']()}</h2>
        <p>{m['about.vision_desc']()}</p>
      </wa-card>

      <wa-card>
        <Icon name="heart" appearance="filled"></Icon>
        <h2>{m['about.values_title']()}</h2>
        <p>{m['about.values_desc']()}</p>
      </wa-card>
    </Grid>

    <wa-card>
      <wa-badge variant="brand" appearance="filled" pill>
        <wa-icon slot="start" name="screwdriver-wrench"></wa-icon>
        {m['lisboa_repair_project.badge']()}
      </wa-badge>
      <h2>{m['lisboa_repair_project.title']()}</h2>
      <p>{m['lisboa_repair_project.subtitle']()}</p>
      <p>{m['lisboa_repair_project.desc']()}</p>
      <div>
        <wa-button variant="brand" href={localizeHref('/sobre/lisboa-repair-project')}>
          <wa-icon name="arrow-right" slot="end"></wa-icon>
          {m['lisboa_repair_project.button']()}
        </wa-button>
      </div>
    </wa-card>

    <section>
      <h2>{m['about.how_title']()}</h2>
      <Grid direction="row" fullWidth break="small">
        <wa-card>
          <div class="step-number">1</div>
          <Icon name="location-dot" appearance="filled"></Icon>
          <h3>{m['about.how_step1_title']()}</h3>
          <p>{m['about.how_step1_desc']()}</p>
        </wa-card>

        <wa-card>
          <div class="step-number">2</div>
          <Icon name="pen-to-square" appearance="filled"></Icon>
          <h3>{m['about.how_step2_title']()}</h3>
          <p>{m['about.how_step2_desc']()}</p>
        </wa-card>

        <wa-card class="step-card">
          <div class="step-number">3</div>
          <Icon name="users" appearance="filled"></Icon>
          <h3>{m['about.how_step3_title']()}</h3>
          <p>{m['about.how_step3_desc']()}</p>
        </wa-card>
      </div>
    </section>

    <section>
      <h2>{m['about.faq_title']()}</h2>
      <wa-accordion>
        <wa-accordion-item label={m['about.faq_q1']()}>
          {m['about.faq_a1']()}
        </wa-accordion-item>
        <wa-accordion-item label={m['about.faq_q2']()}>
          {m['about.faq_a2']()}
        </wa-accordion-item>
        <wa-accordion-item label={m['about.faq_q3']()}>
          {m['about.faq_a3']()}
        </wa-accordion-item>
      </wa-accordion>
    </section>

    <wa-callout variant="neutral" class="cta-callout">
      <wa-icon slot="icon" name="network-wired"></wa-icon>
      <h2>{m['about.cta_title']()}</h2>
      <p>{m['about.cta_desc']()}</p>
      <div class="cta-actions">
        <wa-button variant="brand" href={localizeHref('/mapa')}>
          <wa-icon name="map" slot="start"></wa-icon>
          {m['about.explore_map']()}
        </wa-button>
        <wa-button href={localizeHref('/contactos')}>
          <wa-icon name="envelope" slot="start"></wa-icon>
          {m['about.contact_us']()}
        </wa-button>
      </div>
    </wa-callout>
  </Container>
</Layout>

<style scoped>
section {
  display: flex;
  flex-direction: column;
  gap: var(--wa-space-s);
}
wa-card::part(body),
wa-callout::part(message) {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--wa-space-m);
}

.step-number {
  position: absolute;
  inset-block-start: var(--wa-space-l);
  inset-inline-end: var(--wa-space-l);
  font-size: var(--wa-font-size-2xl);
  font-weight: var(--wa-font-weight-bold);
  color: var(--wa-color-brand-40);
  line-height: 1;
}
</style>
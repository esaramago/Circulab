---
import Layout from '@/layouts/Layout.astro'
import Container from '@/components/ui/Container.vue'
import Back from '@/components/ui/Back.vue'
import { m } from '@/paraglide/messages.js'
import { localizeHref } from '@/paraglide/runtime.js'
import Headline from '@/components/ui/Headline.vue'
import Grid from '@/components/ui/Grid.vue'
import Icon from '@/components/ui/Icon.vue'
---

<script>
  import '@awesome.me/webawesome/dist/components/card/card.js'
  import '@awesome.me/webawesome/dist/components/icon/icon.js'
  import '@awesome.me/webawesome/dist/components/button/button.js'
  import '@awesome.me/webawesome/dist/components/callout/callout.js'
  import '@awesome.me/webawesome/dist/components/badge/badge.js'
</script>

<Layout title={m['lisboa_repair_project.title']()}>
  <Container width="m">
    <Back href={localizeHref('/sobre')} />
    <Headline
      title={m['lisboa_repair_project.title']()}
      subtitle={m['lisboa_repair_project.subtitle']()}
    >
      <wa-badge slot="badge" variant="brand" appearance="filled" pill>
        <wa-icon slot="start" name="screwdriver-wrench"></wa-icon>
        {m['lisboa_repair_project.badge']()}
      </wa-badge>
    </Headline>

    <wa-card>
      <h2>{m['lisboa_repair_project.challenge_title']()}</h2>
      <p>{m['lisboa_repair_project.challenge_p1']()}</p>
      <p>{m['lisboa_repair_project.challenge_p2']()}</p>
      <wa-callout>
        <wa-icon name="lightbulb" slot="icon"></wa-icon>
        <span>{m['lisboa_repair_project.challenge_highlight']()}</span>
      </wa-callout>
    </wa-card>

    <section>
      <h2>{m['lisboa_repair_project.building_title']()}</h2>
      <Grid break="small">
        <wa-card>
          <p>{m['lisboa_repair_project.building_p1']()}</p>
          <p>{m['lisboa_repair_project.building_p2']()}</p>
        </wa-card>
        <wa-callout variant="neutral">
          <wa-icon slot="icon" name="quote-left"></wa-icon>
          <blockquote>{m['lisboa_repair_project.building_quote']()}</blockquote>
        </wa-callout>
      </Grid>
    </section>

    <section>
      <h2>{m['lisboa_repair_project.approach_title']()}</h2>
      <Grid break="small" fullWidth>
        <wa-card>
          <Icon name="eye" appearance="filled"></Icon>
          <h3>{m['lisboa_repair_project.approach_visible_title']()}</h3>
          <p>{m['lisboa_repair_project.approach_visible_desc']()}</p>
        </wa-card>

        <wa-card>
          <Icon name="unlock" appearance="filled"></Icon>
          <h3>{m['lisboa_repair_project.approach_accessible_title']()}</h3>
          <p>{m['lisboa_repair_project.approach_accessible_desc']()}</p>
        </wa-card>

        <wa-card>
          <Icon name="users" appearance="filled"></Icon>
          <h3>{m['lisboa_repair_project.approach_collective_title']()}</h3>
          <p>{m['lisboa_repair_project.approach_collective_desc']()}</p>
        </wa-card>

        <wa-card>
          <Icon name="heart" appearance="filled"></Icon>
          <h3>{m['lisboa_repair_project.approach_human_title']()}</h3>
          <p>{m['lisboa_repair_project.approach_human_desc']()}</p>
        </wa-card>
      </Grid>
    </section>

    <section>
      <h2>{m['lisboa_repair_project.who_title']()}</h2>
      <wa-card>
        <wa-badge variant="brand" appearance="filled" pill>
          <wa-icon slot="start" name="tree"></wa-icon>
          Climate Circle Lisbon
        </wa-badge>
        <p>{m['lisboa_repair_project.who_desc1']()}</p>
        <p>{m['lisboa_repair_project.who_desc2']()}</p>
        <Grid gap="s">
          <wa-button href="https://climatecirclelisbon.org" target="_blank" rel="noopener noreferrer">
            <wa-icon name="globe" slot="start"></wa-icon>
            {m['lisboa_repair_project.who_website']()}
          </wa-button>
          <wa-button href="https://www.linkedin.com/company/climate-circle-lisbon/posts/?feedView=all" target="_blank" rel="noopener noreferrer">
            <wa-icon name="arrow-up-right-from-square" slot="start"></wa-icon>
            {m['lisboa_repair_project.who_linkedin']()}
          </wa-button>
        </Grid>
      </wa-card>
    </section>

    <section>
      <div>
        <h2>{m['lisboa_repair_project.partners_title']()}</h2>
        <p>{m['lisboa_repair_project.partners_subtitle']()}</p>
      </div>
      <Grid fullWidth break="small">
        <wa-card>
          <Grid align="center" gap="s">
            <Icon name="rotate" appearance="filled"></Icon>
            <h3>The Next Turn.Lisbon</h3>
          </Grid>
          <p>{m['lisboa_repair_project.partner_nextturn_desc']()}</p>
          <div slot="footer">
            <wa-button href="https://www.instagram.com/thenextturn.lisbon/" target="_blank" rel="noopener noreferrer">
              <wa-icon name="arrow-up-right-from-square" slot="start"></wa-icon>
              Instagram
            </wa-button>
          </div>
        </wa-card>

        <wa-card>
          <Grid align="center" gap="s">
            <Icon name="gem" appearance="filled"></Icon>
            <h3>Arches</h3>
          </Grid>
          <p>{m['lisboa_repair_project.partner_arches_desc']()}</p>
          <div slot="footer">
            <wa-button href="https://archesglobal.co/" target="_blank" rel="noopener noreferrer">
              <wa-icon name="globe" slot="start"></wa-icon>
              {m['lisboa_repair_project.who_website']()}
            </wa-button>
          </div>
        </wa-card>
      </Grid>

      <Grid fullWidth break="small">
        <wa-card>
          <Grid align="center" gap="s">
            <Icon name="building-columns" appearance="filled"></Icon>
            <h3>Rizoma</h3>
          </Grid>
          <p>{m['lisboa_repair_project.partner_rizoma_desc']()}</p>
          <div slot="footer">
            <wa-button href="https://www.rizomacoop.pt/" target="_blank" rel="noopener noreferrer">
              <wa-icon name="globe" slot="start"></wa-icon>
              {m['lisboa_repair_project.who_website']()}
            </wa-button>
          </div>
        </wa-card>

        <wa-card>
          <Grid align="center" gap="s">
            <Icon name="seedling" appearance="filled"></Icon>
            <h3>ECOLISE</h3>
          </Grid>
          <p>{m['lisboa_repair_project.partner_ecolise_desc']()}</p>
          <div slot="footer">
            <wa-button href="https://ecolise.eu/how-we-do-it/regenerative-communities-fund/" target="_blank" rel="noopener noreferrer">
              <wa-icon name="globe" slot="start"></wa-icon>
              {m['lisboa_repair_project.who_website']()}
            </wa-button>
          </div>
        </wa-card>
      </Grid>
    </section>

    <section>
      <h2>{m['lisboa_repair_project.journey_title']()}</h2>
      <Grid break="small" fullWidth>
        <wa-card>
          <Icon name="seedling" appearance="filled"></Icon>
          <h3>{m['lisboa_repair_project.journey_step1_title']()}</h3>
          <p>{m['lisboa_repair_project.journey_step1_desc']()}</p>
        </wa-card>

        <wa-card>
          <Icon name="map-location-dot" appearance="filled"></Icon>
          <h3>{m['lisboa_repair_project.journey_step2_title']()}</h3>
          <p>{m['lisboa_repair_project.journey_step2_desc']()}</p>
          <Grid gap="xs">
            <wa-button href="https://docs.google.com/forms/d/1yJHvmQoy5Th1rfsr8hMjZzfFqmofLVzMjDYNtqAsEWY" target="_blank" rel="noopener noreferrer">
              <wa-icon name="globe" slot="start"></wa-icon>
              {m['lisboa_repair_project.journey_step2_link1']()}
            </wa-button>
            <wa-button href="https://docs.google.com/forms/d/19CE0nSJ_tk8Ho4tFlIcJniH0Xeep4pOv0GSFq-HvbNA" target="_blank" rel="noopener noreferrer">
              <wa-icon name="globe" slot="start"></wa-icon>
              {m['lisboa_repair_project.journey_step2_link2']()}
            </wa-button>
          </Grid>
        </wa-card>
      </Grid>
    </section>

    <wa-callout variant="neutral">
      <wa-icon slot="icon" name="people-group"></wa-icon>
      <h2>{m['lisboa_repair_project.join_title']()}</h2>
      <p>{m['lisboa_repair_project.join_desc']()}</p>
      <div>
        <wa-icon name="handshake"></wa-icon>
        <span>{m['lisboa_repair_project.join_highlight']()}</span>
      </div>
      <Grid gap="s">
        <wa-button href="mailto:climatecirclelisbon@gmail.com">
          <wa-icon name="envelope" slot="start"></wa-icon>
          {m['lisboa_repair_project.send_email']()}
        </wa-button>
        <wa-button href="https://www.instagram.com/lisboarepairproject/" target="_blank" rel="noopener noreferrer">
          <wa-icon name="arrow-up-right-from-square" slot="start"></wa-icon>
          {m['lisboa_repair_project.visit_instagram']()}
        </wa-button>
        <wa-button href={localizeHref('/mapa')}>
          <wa-icon name="map" slot="start"></wa-icon>
          {m['about.explore_map']()}
        </wa-button>
      </Grid>
    </wa-callout>
  </Container>
</Layout>

<style scoped>
section {
  display: flex;
  flex-direction: column;
  gap: var(--wa-space-s);
}
</style>
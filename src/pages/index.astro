---
import Layout from '@/layouts/Layout.astro'
import { m } from '@/paraglide/messages.js'
import Map from '@/components/pages/map/Map.vue'
import Grid from '@/components/ui/Grid.vue'
---

<Layout title={m.site_title()}>
  <Grid gap="l" direction="column" align="center">
    <h1>Mapa colaborativo para a agroecologia e a circularidade.</h1>
    <p>Plataforma de cartografia participativa dedicada à identificação e valorização de recursos urbanos subutilizados ou desperdiçados.</p>
    <Grid align="center" justify="center">
      <wa-button href="/sobre" size="l">Saber mais</wa-button>
      <wa-button href="/mapa" variant="brand" size="l">
        <wa-icon name="map" slot="start"></wa-icon>
        Explorar recursos
      </wa-button>
      <wa-button href="/mapa?code=repair-map" variant="brand" size="l">
        <img slot="start" src="/img/lisboa-repair-map.webp" alt="Lisboa Repair Map" width="30" height="30" />
        Lisboa Repair Map
      </wa-button>
    </Grid>
  </Grid>
  <Map client:only="vue" hide-filters={true} class="map" />
</Layout>

<style scoped>
h1 {
  text-align: center;
  max-width: 65rem;
  font-size: var(--wa-font-size-3xl);
  line-height: 1.2;
}
p {
  font-size: var(--wa-font-size-l);
  text-align: center;
  max-width: 70rem;
  color: var(--wa-color-brand-60);
}
.map {
  min-height: 60vh;
}
</style>
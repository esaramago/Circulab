---
import Layout from '@/layouts/Layout.astro'
import { m } from '@/paraglide/messages.js'
import Map from '@/components/pages/map/Map.vue'
import Grid from '@/components/ui/Grid.vue'
import { localizeHref } from '@/paraglide/runtime.js'
---

<Layout title={m.site_title()}>
  <Grid gap="l" direction="column" align="center">
    <h1>{m['home.hero_title']()}</h1>
    <p>{m['home.hero_description']()}</p>
    <Grid align="center" justify="center" wrap>
      <wa-button href={localizeHref('/sobre')} size="l">{m['home.learn_more']()}</wa-button>
      <wa-button href={localizeHref('/mapa')} variant="brand" size="l">
        <wa-icon name="map" slot="start"></wa-icon>
        {m['home.explore_resources']()}
      </wa-button>
      <wa-button href={localizeHref('/mapa?code=repair-map')} variant="brand" size="l">
        <img slot="start" src="/img/lisboa-repair-map.webp" alt="Lisboa Repair Project" width="30" height="30" />
        Lisboa Repair Project
      </wa-button>
    </Grid>
  </Grid>
  <Map client:only="vue" hide-filters={true} class="map" />
</Layout>

<style scoped>
h1 {
  text-align: center;
  max-width: 65rem;
  font-size: var(--wa-font-size-3xl);
  line-height: 1.2;
}
p {
  font-size: var(--wa-font-size-l);
  text-align: center;
  max-width: 70rem;
  color: var(--wa-color-brand-60);
}
.map {
  min-height: 60vh;
}
</style>
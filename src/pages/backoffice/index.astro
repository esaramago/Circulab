---
import Layout from '@/layouts/Layout.astro'
import { userHasAccess } from '@/utils/userHasAccess'
import { localizeHref } from '@/paraglide/runtime.js'
import Grid from '@/components/ui/Grid.vue'
import { m } from '@/paraglide/messages.js'

const user = Astro.locals.user

// Block non-admin users
if (!user || !userHasAccess(user, 'backoffice')) {
  return Astro.redirect('/')
}

const cards = [
  {
    title: m['backoffice.typologies_title'](),
    description: m['backoffice.typologies_desc'](),
    href: localizeHref('/backoffice/typologies'),
    icon: 'layer-group'
  },
  {
    title: m['backoffice.categories_title'](),
    description: m['backoffice.categories_desc'](),
    href: localizeHref('/backoffice/categories'),
    icon: 'tags'
  }
]
---

<script>
  import '@awesome.me/webawesome/dist/components/card/card.js'
  import '@awesome.me/webawesome/dist/components/icon/icon.js'
</script>

<Layout title={m['backoffice.title']()}>
  <Grid gap="l" direction="column">
    <div>
      <h1>{m['backoffice.title']()}</h1>
      <p>{m['backoffice.subtitle']()}</p>
    </div>

    <Grid gap="l">
      {
        cards.map((card) => (
          <a href={card.href} class="u-text-decoration-none">
            <wa-card>
              <Grid direction="column">
                <Grid align="center" gap="s">
                  <div class="admin-card__icon">
                    <wa-icon name={card.icon}></wa-icon>
                  </div>
                  <h3>{card.title}</h3>
                </Grid>
                <p>{card.description}</p>
              </Grid>
              <div slot="footer">
                {card.title} <wa-icon name="arrow-right" slot="suffix"></wa-icon>
              </div>
            </wa-card>
          </a>
        ))
      }
    </Grid>
  </Grid>
</Layout>

<style>

.admin-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 4rem;
  height: 4rem;
  font-size: 2.4rem;
  color: var(--wa-color-brand-50);
  background-color: var(--wa-color-brand-90);
  border-radius: var(--wa-border-radius-m);
  flex-shrink: 0;
}

</style>

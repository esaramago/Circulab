---
import Layout from '@/layouts/Layout.astro'
import { fetchDB } from '@/utils/fetchDB'
import { userHasAccess } from '@/utils/userHasAccess'
import { localizeHref } from '@/paraglide/runtime.js'
import Grid from '@/components/ui/Grid.vue'
import Back from '@/components/ui/Back.vue'
import { CONFIG } from '@/config'
import { m } from '@/paraglide/messages.js'

const user = Astro.locals.user

// Server-side security check
if (!user || !userHasAccess(user, 'backoffice')) {
  return Astro.redirect('/')
}

// Fetch typologies for selection
const { data: typologiesData } = await fetchDB('typologies')
  .select('*')
  .order('name', { ascending: true })

const typologies = typologiesData || []
---
<script>
  import '@awesome.me/webawesome/dist/components/card/card.js'
  import '@awesome.me/webawesome/dist/components/icon/icon.js'
</script>

<Layout title={m['backoffice.select_typology']()}>
  <Grid direction="column" gap="l">
    <div class="backoffice-page__nav">
      <Back href={localizeHref('/backoffice')}>{m['backoffice.back_to_panel']()}</Back>
    </div>

    <Grid gap="l" direction="column">
      <div>
        <h2>{m['backoffice.select_typology']()}</h2>
        <p class="subtitle">{m['backoffice.select_typology_subtitle']()}</p>
      </div>

      <div class="typology-grid">
        {
          typologies.map((t) => (
            <a href={localizeHref(`/backoffice/categories/${t.id}`)} class="u-text-decoration-none">
              <wa-card>
                <Grid direction="column">
                  <Grid align="center" gap="s">
                    <span class="color-indicator" style={`background-color: ${t.color || '#cccccc'}`}></span>
                    {t.icon && (
                      <wa-icon
                        src={t.icon.includes('/') || t.icon.endsWith('.svg') || t.icon.startsWith('http') ? CONFIG.images_url + 'pin-images/' + t.icon : undefined}
                        name={!(t.icon.includes('/') || t.icon.endsWith('.svg') || t.icon.startsWith('http')) ? t.icon : undefined}
                      ></wa-icon>
                    )}
                    <h3>{t.name}</h3>
                  </Grid>
                  <p>{t.description}</p>
                </Grid>
                <div slot="footer">
                  <span>{m['backoffice.manage_categories']()}</span>
                  <wa-icon name="arrow-right"></wa-icon>
                </div>
              </wa-card>
            </a>
          ))
        }
      </div>
    </Grid>
  </Grid>
</Layout>

<script>
  import '@awesome.me/webawesome/dist/components/icon/icon.js'
</script>

<style>
  .typology-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--wa-space-l);
  }
  wa-card {
    height: 100%;
    &::part(body) {
      flex: 1;
    }
  }

  .color-indicator {
    width: 1rem;
    height: 1rem;
    border-radius: var(--wa-border-radius-circle);
    flex-shrink: 0;
  }
</style>

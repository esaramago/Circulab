---
import Layout from '@/layouts/Layout.astro'
import CategoriesManager from '@/components/pages/backoffice/CategoriesManager.vue'
import { fetchDB } from '@/utils/fetchDB'
import { userHasAccess } from '@/utils/userHasAccess'
import { localizeHref } from '@/paraglide/runtime.js'
import Grid from '@/components/ui/Grid.vue'
import Back from '@/components/ui/Back.vue'
import { m } from '@/paraglide/messages.js'

const user = Astro.locals.user

// Server-side security check
if (!user || !userHasAccess(user, 'backoffice')) {
  return Astro.redirect('/')
}

const { id } = Astro.params

if (!id) {
  return Astro.redirect(localizeHref('/backoffice/categories'))
}

// Fetch specific typology to check if it exists
const { data: typologyData, error: typologyError } = await fetchDB('typologies')
  .select('*')
  .eq('id', id)
  .single()

if (typologyError || !typologyData) {
  return Astro.redirect(localizeHref('/backoffice/categories'))
}

// Fetch categories for this specific typology
const { data: categoriesData } = await fetchDB('categories')
  .select('*')
  .eq('typology_id', id)
  .order('created_at', { ascending: false })

// Fetch all typologies to display metadata or default options
const { data: typologiesData } = await fetchDB('typologies')
  .select('*')
  .order('name', { ascending: true })

const categories = categoriesData || []
const typologies = typologiesData || []
---

<Layout title={`${m['backoffice.manage_categories_title']()} - ${typologyData.name}`}>
  <Grid direction="column" gap="l">
    <div class="backoffice-page__nav">
      <Back href={localizeHref('/backoffice/categories')}>{m['backoffice.back_to_typology_select']()}</Back>
    </div>
    
    <CategoriesManager
      client:only="vue"
      initialCategories={categories}
      typologies={typologies}
      initialSelectedTypologyId={id}
    />
  </Grid>
</Layout>

<script>
  import '@awesome.me/webawesome/dist/components/icon/icon.js'
</script>

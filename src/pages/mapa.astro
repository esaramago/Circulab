---
import Layout from '@/layouts/Layout.astro'
import { m } from '@/paraglide/messages.js'
import Map from '@/components/pages/map/Map.vue'
import ResourceCards from '@/components/pages/map/ResourceCards.vue'
import MapFilters from '@/components/pages/map/MapFilters.vue'
import MapActions from '@/components/pages/map/MapActions.vue'
import Grid from '@/components/ui/Grid.vue'
import type { MapViewMode } from '@/stores/map'

const defaultTypologyCode = Astro.url.searchParams.get('code')
const initialView: MapViewMode = Astro.url.searchParams.get('view') === 'cards' ? 'cards' : 'map'
---

<Layout title={m['map.title']()} fullWidth={true}>
  <div class="wrapper">
    <Grid justify="space-between" align="center" class="header">
      <h1>{m['map.title']()}</h1>
      <MapActions client:only="vue" initialView={initialView} />
    </Grid>
    <MapFilters class="filters" client:only="vue" defaultTypologyCode={defaultTypologyCode} />
    <div class="content">
      <Map class="map" client:only="vue" />
      <ResourceCards class="cards" client:only="vue" />
    </div>
  </div>
</Layout>

<style>
.wrapper {
  display: grid;
  grid-template-rows: min-content auto;
  grid-template-columns: 34rem minmax(0, 1fr);
  grid-template-areas:
    "header header"
    "filters content";
  align-items: start;
  gap: var(--wa-space-l);
  flex: 1;
  @media (max-width: 1023px) {
    padding-inline: var(--wa-space-m);
    grid-template-columns: 1fr;
    grid-template-areas:
      "header"
      "content";
  }
}
.header {
  grid-area: header;
}
.filters {
  grid-area: filters;
}
.content {
  grid-area: content;
  display: flex;
  flex-direction: column;
  min-width: 0;
  align-self: stretch;
}
.map {
  align-self: stretch;
}
</style>
  